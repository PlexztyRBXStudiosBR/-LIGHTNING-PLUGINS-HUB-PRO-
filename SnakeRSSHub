local function safeFireRemote(remote, ...)
    if remote and typeof(remote) == "Instance" then
        if remote:IsA("RemoteEvent") then
            pcall(function(...) remote:FireServer(...) end, ...)
        elseif remote:IsA("RemoteFunction") then
            pcall(function(...) remote:InvokeServer(...) end, ...)
        end
    end
end

local function getBall()
    local ball = Workspace:FindFirstChild("ball") or Workspace:FindFirstChild("Ball")
    if ball and ball:IsA("BasePart") then return ball end
    for _, obj in ipairs(Workspace:GetChildren()) do
        if obj:IsA("BasePart") and not obj.Anchored and (string.lower(obj.Name):find("ball") or obj.Shape == Enum.PartType.Ball) then
            return obj
        end
    end
    return nil
end

local function getRootPart(player)
    player = player or LocalPlayer
    local char = player and player.Character
    return char and (char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso") or char:FindFirstChild("UpperTorso"))
end

local function getOpponentGoal()
    local homeGoal = Workspace:FindFirstChild("HomeGoal")
    local awayGoal = Workspace:FindFirstChild("AwayGoal")
    if not homeGoal and not awayGoal then return nil end
    local root = getRootPart()
    if root then
        local homePos = homeGoal and (homeGoal:FindFirstChild("Frame") and homeGoal.Frame:FindFirstChild("Crossbar") and homeGoal.Frame.Crossbar.Position or homeGoal:GetPivot().Position) or Vector3.new(0,0,0)
        local awayPos = awayGoal and (awayGoal:FindFirstChild("Frame") and awayGoal.Frame:FindFirstChild("Crossbar") and awayGoal.Frame.Crossbar.Position or awayGoal:GetPivot().Position) or Vector3.new(0,0,0)
        local distHome = (root.Position - homePos).Magnitude
        local distAway = (root.Position - awayPos).Magnitude
        return distHome < distAway and awayGoal or homeGoal
    end
    return awayGoal or homeGoal
end

local function calculateBestShotTarget(opponentGoal, shotStyle)
    if not opponentGoal then return nil end
    local crossbar = opponentGoal:FindFirstChild("Frame") and opponentGoal.Frame:FindFirstChild("Crossbar")
    local baseCFrame = crossbar and crossbar.CFrame or opponentGoal:GetPivot()
    local goalPos = baseCFrame.Position
    local goalRight = baseCFrame.RightVector
    local goalUp = baseCFrame.UpVector

    shotStyle = shotStyle or Config.AutoShoot.ShotStyle
    if shotStyle:find("Random") then
        local styles = {"Top Left", "Top Right", "Low Left", "Low Right", "Trivela"}
        local chosen = styles[math.random(1, #styles)]
        if chosen == "Top Left" then return goalPos - (goalRight * 7.5) - (goalUp * 1.5)
        elseif chosen == "Top Right" then return goalPos + (goalRight * 7.5) - (goalUp * 1.5)
        elseif chosen == "Low Left" then return goalPos - (goalRight * 7.8) - (goalUp * 6.5)
        elseif chosen == "Low Right" then return goalPos + (goalRight * 7.8) - (goalUp * 6.5)
        else return goalPos + (goalRight * 6.8) - (goalUp * 2.2) end
    elseif shotStyle:find("Top Bins") then
        return goalPos + (goalRight * 7.5 * (math.random() > 0.5 and 1 or -1)) - (goalUp * 1.5)
    else
        return goalPos + (goalRight * 7.2) - (goalUp * 2.0)
    end
end

local function executeAutoShoot(isManualClick)
    local ball = getBall()
    local root = getRootPart()
    local oppGoal = getOpponentGoal()
    if not oppGoal then return end

    local targetPos = calculateBestShotTarget(oppGoal, Config.AutoShoot.ShotStyle)
    if not targetPos then return end

    local ballPos = ball and ball.Position or (root and (root.Position + root.CFrame.LookVector * 2.5))
    local distance = (targetPos - ballPos).Magnitude
    local direction = (targetPos - ballPos).Unit

    local elevationOffset = Vector3.new(0, math.clamp(Config.AutoShoot.Elevation + (distance * 0.055), 8, 38), 0)
    local curveAngle = (Config.AutoShoot.CurveIntensity / 100) * 12
    local curveVector = Vector3.new(-direction.Z * curveAngle, 0, direction.X * curveAngle)
    local calculatedPower = math.clamp(Config.AutoShoot.ShotPower + (distance * 1.8), 240, 520)

    local finalVelocity = (direction * calculatedPower) + elevationOffset + curveVector

    safeFireRemote(Remotes.ShootTheBall, targetPos, calculatedPower, curveAngle)
    safeFireRemote(Remotes.ShootTheBaII, targetPos, calculatedPower, curveAngle)
    safeFireRemote(Remotes.Action, "Shoot", targetPos, calculatedPower)

    if ball and ball:IsA("BasePart") and root and (ball.Position - root.Position).Magnitude <= 18 then
        ball.AssemblyLinearVelocity = finalVelocity
        ball.AssemblyAngularVelocity = Vector3.new(curveAngle * 10, 0, -curveAngle * 10)
    end

    if root and isManualClick then
        root.CFrame = CFrame.lookAt(root.Position, Vector3.new(targetPos.X, root.Position.Y, targetPos.Z))
    end
end

