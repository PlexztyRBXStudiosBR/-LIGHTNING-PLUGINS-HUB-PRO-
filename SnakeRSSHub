    Size = UDim2.fromOffset(330, 330), Position = UDim2.new(0, 40, 0, 60),
    BackgroundColor3 = Color3.fromRGB(14, 14, 18), BackgroundTransparency = 0.08,
    BorderSizePixel = 0, Active = true,
  }, sg)
