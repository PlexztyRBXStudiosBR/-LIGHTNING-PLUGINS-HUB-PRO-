local function MakeSlider(parent, yPos, labelText, minVal, maxVal, defaultVal, callback)
    local lbl = Instance.new("TextLabel")
    lbl.BackgroundTransparency = 1
    lbl.Position = UDim2.new(0, 10, 0, yPos)
    lbl.Size = UDim2.new(1, -20, 0, 14)
    lbl.Font = Enum.Font.GothamMedium
    lbl.Text = labelText .. ": " .. defaultVal
    lbl.TextColor3 = Theme.TextDim
    lbl.TextSize = 10
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.ZIndex = 103
    lbl.Parent = parent
    
    local bg = Instance.new("Frame")
    bg.BackgroundColor3 = Theme.Tertiary
    bg.Position = UDim2.new(0, 10, 0, yPos + 16)
    bg.Size = UDim2.new(1, -20, 0, 14)
    bg.ZIndex = 103
    bg.Parent = parent
    CreateCorner(bg, 7)
    
    local fill = Instance.new("Frame")
    fill.BackgroundColor3 = Color3.fromRGB(255, 100, 100)
    fill.Size = UDim2.new((defaultVal - minVal) / (maxVal - minVal), 0, 1, 0)
    fill.ZIndex = 104
    fill.Parent = bg
    CreateCorner(fill, 7)
    
    local drag = false
    bg.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.Touch or i.UserInputType == Enum.UserInputType.MouseButton1 then
            drag = true
        end
    end)
    bg.InputEnded:Connect(function() drag = false end)
    
    UserInputService.InputChanged:Connect(function(i)
        if drag and (i.UserInputType == Enum.UserInputType.Touch or i.UserInputType == Enum.UserInputType.MouseMovement) then
            local rel = math.clamp((i.Position.X - bg.AbsolutePosition.X) / bg.AbsoluteSize.X, 0, 1)
            fill.Size = UDim2.new(rel, 0, 1, 0)
            local val = minVal + (maxVal - minVal) * rel
            lbl.Text = labelText .. ": " .. math.floor(val)
            callback(val)
        end
    end)
end

