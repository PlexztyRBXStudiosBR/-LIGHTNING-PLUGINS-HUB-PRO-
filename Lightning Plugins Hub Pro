-- FUNCAO PARA CRIAR ARVORE CLASSICA
local function MakeTreeClassic(pos, tType, sz)
    local folder = Instance.new("Model")
    folder.Name = "Tree_" .. tType
    
    local tH = 8 * sz
    local tW = 1.5 * sz
    
    local trunk = Instance.new("Part")
    trunk.Name = "Trunk"
    trunk.Size = Vector3.new(tW, tH, tW)
    trunk.Position = pos + Vector3.new(0, tH/2, 0)
    trunk.Color = Color3.fromRGB(139, 90, 43)
    trunk.Material = Enum.Material.Wood
    trunk.Anchored = true
    trunk.Parent = folder
    
    if tType == "Oak" then
        local leaves = Instance.new("Part")
        leaves.Shape = Enum.PartType.Ball
        leaves.Size = Vector3.new(10*sz, 8*sz, 10*sz)
        leaves.Position = pos + Vector3.new(0, tH + 3*sz, 0)
        leaves.Color = Color3.fromRGB(34, 139, 34)
        leaves.Material = Enum.Material.Grass
        leaves.Anchored = true
        leaves.Parent = folder
    elseif tType == "Pine" then
        for i = 1, 4 do
            local cone = Instance.new("Part")
            cone.Size = Vector3.new((5-i)*sz, 3*sz, (5-i)*sz)
            cone.Position = pos + Vector3.new(0, tH - 2 + i*2.5*sz, 0)
            cone.Color = Color3.fromRGB(34, 100, 34)
            cone.Material = Enum.Material.Grass
            cone.Anchored = true
            cone.Parent = folder
        end
    elseif tType == "Palm" then
        trunk.Size = Vector3.new(tW*0.8, tH*1.2, tW*0.8)
        trunk.Position = pos + Vector3.new(0, tH*0.6, 0)
        for i = 1, 6 do
            local frond = Instance.new("Part")
            frond.Size = Vector3.new(8*sz, 0.5*sz, 2*sz)
            local ang = math.rad(i*60)
            frond.CFrame = CFrame.new(pos + Vector3.new(0, tH*1.2, 0)) * CFrame.Angles(0, ang, math.rad(30)) * CFrame.new(4*sz, 0, 0)
            frond.Color = Color3.fromRGB(50, 180, 50)
            frond.Material = Enum.Material.Grass
            frond.Anchored = true
            frond.Parent = folder
        end
    elseif tType == "Cherry" then
        local leaves = Instance.new("Part")
        leaves.Shape = Enum.PartType.Ball
        leaves.Size = Vector3.new(9*sz, 7*sz, 9*sz)
        leaves.Position = pos + Vector3.new(0, tH + 2.5*sz, 0)
        leaves.Color = Color3.fromRGB(255, 182, 193)
        leaves.Material = Enum.Material.Grass
        leaves.Anchored = true
        leaves.Parent = folder
    elseif tType == "Autumn" then
        local leaves = Instance.new("Part")
        leaves.Shape = Enum.PartType.Ball
        leaves.Size = Vector3.new(10*sz, 8*sz, 10*sz)
        leaves.Position = pos + Vector3.new(0, tH + 3*sz, 0)
        leaves.Color = Color3.fromRGB(255, 140, 0)
        leaves.Material = Enum.Material.Grass
        leaves.Anchored = true
        leaves.Parent = folder
    elseif tType == "Dead" then
        trunk.Color = Color3.fromRGB(80, 60, 40)
        for i = 1, 3 do
            local branch = Instance.new("Part")
            branch.Size = Vector3.new(0.5*sz, 4*sz, 0.5*sz)
            local ang = math.rad(i*120)
            branch.CFrame = CFrame.new(pos + Vector3.new(0, tH*0.8, 0)) * CFrame.Angles(0, ang, math.rad(45)) * CFrame.new(2*sz, 0, 0)
            branch.Color = Color3.fromRGB(80, 60, 40)
            branch.Material = Enum.Material.Wood
            branch.Anchored = true
            branch.Parent = folder
        end
    end
    
    folder.Parent = workspace
    return folder
end

-- FUNCAO PARA CRIAR ARVORE DETALHADA
local function MakeTreeDetailed(pos, tType, sz)
    local folder = Instance.new("Model")
    folder.Name = "DetailedTree_" .. tType
    
    local tH = 10 * sz
    local tW = 1.8 * sz
    
    -- Tronco com textura
    local trunk = Instance.new("Part")
    trunk.Name = "Trunk"
    trunk.Size = Vector3.new(tW, tH, tW)
    trunk.Position = pos + Vector3.new(0, tH/2, 0)
    trunk.Color = Color3.fromRGB(101, 67, 33)
    trunk.Material = Enum.Material.WoodPlanks
    trunk.Anchored = true
    trunk.Parent = folder
    
    -- Adicionar rugosidade ao tronco
    local barkTexture = Instance.new("Texture")
    barkTexture.Texture = "rbxasset://textures/SpawnLocation.png"
    barkTexture.StudsPerTileU = 2
    barkTexture.StudsPerTileV = 2
    barkTexture.Face = Enum.NormalId.Front
    barkTexture.Parent = trunk
    
    if tType == "Oak" then
        -- Galhos principais
        for i = 1, 5 do
            local branch = Instance.new("Part")
            branch.Size = Vector3.new(tW*0.6, tH*0.4, tW*0.6)
            local angle = math.rad(i * 72)
            local height = tH * (0.6 + i * 0.05)
            branch.CFrame = CFrame.new(pos + Vector3.new(0, height, 0)) * CFrame.Angles(0, angle, math.rad(35)) * CFrame.new(2*sz, 0, 0)
            branch.Color = Color3.fromRGB(101, 67, 33)
            branch.Material = Enum.Material.Wood
            branch.Anchored = true
            branch.Parent = folder
            
            -- Folhagem nos galhos
            for j = 1, 3 do
                local leafCluster = Instance.new("Part")
                leafCluster.Shape = Enum.PartType.Ball
                leafCluster.Size = Vector3.new(3*sz, 3*sz, 3*sz) * (1 + j*0.2)
                leafCluster.CFrame = branch.CFrame * CFrame.new(j*1.5*sz, j*0.5*sz, 0)
                leafCluster.Color = Color3.fromRGB(34, 139, 34)
                leafCluster.Material = Enum.Material.Grass
                leafCluster.Anchored = true
                leafCluster.Transparency = 0.1
                leafCluster.Parent = folder
            end
        end
        
        -- Copa principal
        local mainCanopy = Instance.new("Part")
        mainCanopy.Shape = Enum.PartType.Ball
        mainCanopy.Size = Vector3.new(12*sz, 10*sz, 12*sz)
        mainCanopy.Position = pos + Vector3.new(0, tH + 4*sz, 0)
        mainCanopy.Color = Color3.fromRGB(34, 139, 34)
        mainCanopy.Material = Enum.Material.Grass
        mainCanopy.Anchored = true
        mainCanopy.Transparency = 0.15
        mainCanopy.Parent = folder
        
    elseif tType == "Pine" then
        -- Pinheiro detalhado em camadas
        for layer = 1, 7 do
            local layerSize = (8 - layer) * sz
            local layerHeight = tH * 0.5 + layer * 1.5 * sz
            
            for segment = 1, 8 do
                local needle = Instance.new("Part")
                needle.Size = Vector3.new(layerSize * 0.8, 0.4*sz, 1.2*sz)
                local angle = math.rad(segment * 45)
                needle.CFrame = CFrame.new(pos + Vector3.new(0, layerHeight, 0)) * CFrame.Angles(0, angle, math.rad(-25)) * CFrame.new(layerSize*0.4, 0, 0)
                needle.Color = Color3.fromRGB(34, 100, 34)
                needle.Material = Enum.Material.Grass
                needle.Anchored = true
                needle.Parent = folder
            end
        end
        
        -- Topo pontiagudo
        local top = Instance.new("Part")
        top.Size = Vector3.new(1*sz, 3*sz, 1*sz)
        top.Position = pos + Vector3.new(0, tH + 6*sz, 0)
        top.Color = Color3.fromRGB(34, 100, 34)
        top.Material = Enum.Material.Grass
        top.Anchored = true
        top.Parent = folder
        
    elseif tType == "Palm" then
        -- Tronco curvado
        trunk.Size = Vector3.new(tW*0.9, tH*1.3, tW*0.9)
        trunk.CFrame = CFrame.new(pos + Vector3.new(0, tH*0.65, 0)) * CFrame.Angles(0, 0, math.rad(10))
        
        -- Anéis no tronco
        for ring = 1, 8 do
            local ringPart = Instance.new("Part")
            ringPart.Shape = Enum.PartType.Cylinder
            ringPart.Size = Vector3.new(0.3*sz, tW*1.2, tW*1.2)
            ringPart.Position = pos + Vector3.new(0, ring * tH * 0.15, 0)
            ringPart.Orientation = Vector3.new(0, 0, 90)
            ringPart.Color = Color3.fromRGB(120, 80, 40)
            ringPart.Material = Enum.Material.Wood
            ringPart.Anchored = true
            ringPart.Parent = folder
        end
        
        -- Folhas de palmeira detalhadas
        for frond = 1, 8 do
            local angle = math.rad(frond * 45)
            local frondBase = CFrame.new(pos + Vector3.new(0, tH*1.3, 0)) * CFrame.Angles(0, angle, math.rad(40))
            
            for segment = 1, 5 do
                local leaf = Instance.new("Part")
                leaf.Size = Vector3.new((6-segment)*sz*0.8, 0.3*sz, 1.5*sz)
                leaf.CFrame = frondBase * CFrame.new(segment*1.5*sz, -segment*0.3*sz, 0)
                leaf.Color = Color3.fromRGB(50, 180, 50)
                leaf.Material = Enum.Material.Grass
                leaf.Anchored = true
                leaf.Parent = folder
            end
        end
        
    elseif tType == "Cherry" then
        -- Similar ao Oak mas com flores
        for i = 1, 6 do
            local branch = Instance.new("Part")
            branch.Size = Vector3.new(tW*0.5, tH*0.35, tW*0.5)
            local angle = math.rad(i * 60)
            local height = tH * (0.65 + i * 0.04)
            branch.CFrame = CFrame.new(pos + Vector3.new(0, height, 0)) * CFrame.Angles(0, angle, math.rad(30)) * CFrame.new(1.8*sz, 0, 0)
            branch.Color = Color3.fromRGB(101, 67, 33)
            branch.Material = Enum.Material.Wood
            branch.Anchored = true
            branch.Parent = folder
            
            -- Flores de cerejeira
            for j = 1, 4 do
                local blossom = Instance.new("Part")
                blossom.Shape = Enum.PartType.Ball
                blossom.Size = Vector3.new(2.5*sz, 2.5*sz, 2.5*sz)
                blossom.CFrame = branch.CFrame * CFrame.new(j*1.2*sz, j*0.4*sz, (j%2)*0.5*sz)
                blossom.Color = Color3.fromRGB(255, 182, 193)
                blossom.Material = Enum.Material.Neon
                blossom.Anchored = true
                blossom.Transparency = 0.2
                blossom.Parent = folder
            end
        end
        
        -- Copa principal rosa
        local canopy = Instance.new("Part")
        canopy.Shape = Enum.PartType.Ball
        canopy.Size = Vector3.new(11*sz, 9*sz, 11*sz)
        canopy.Position = pos + Vector3.new(0, tH + 3.5*sz, 0)
        canopy.Color = Color3.fromRGB(255, 182, 193)
        canopy.Material = Enum.Material.Neon
        canopy.Anchored = true
        canopy.Transparency = 0.25
        canopy.Parent = folder
        
    elseif tType == "Autumn" then
        -- Árvore de outono com múltiplas cores
        for i = 1, 5 do
            local branch = Instance.new("Part")
            branch.Size = Vector3.new(tW*0.6, tH*0.4, tW*0.6)
            local angle = math.rad(i * 72)
            branch.CFrame = CFrame.new(pos + Vector3.new(0, tH*0.7, 0)) * CFrame.Angles(0, angle, math.rad(40)) * CFrame.new(2*sz, 0, 0)
            branch.Color = Color3.fromRGB(90, 60, 30)
            branch.Material = Enum.Material.Wood
            branch.Anchored = true
            branch.Parent = folder
            
            -- Folhas coloridas de outono
            local colors = {
                Color3.fromRGB(255, 140, 0),
                Color3.fromRGB(255, 69, 0),
                Color3.fromRGB(178, 34, 34),
                Color3.fromRGB(255, 215, 0)
            }
            
            for j = 1, 3 do
                local leafPatch = Instance.new("Part")
                leafPatch.Shape = Enum.PartType.Ball
                leafPatch.Size = Vector3.new(3.5*sz, 3*sz, 3.5*sz)
                leafPatch.CFrame = branch.CFrame * CFrame.new(j*1.5*sz, 0, 0)
                leafPatch.Color = colors[math.random(1, #colors)]
                leafPatch.Material = Enum.Material.Grass
                leafPatch.Anchored = true
                leafPatch.Transparency = 0.1
                leafPatch.Parent = folder
            end
        end
        
        -- Copa principal variada
        for k = 1, 3 do
            local canopyPart = Instance.new("Part")
            canopyPart.Shape = Enum.PartType.Ball
            canopyPart.Size = Vector3.new(8*sz, 7*sz, 8*sz)
            local offset = Vector3.new((k-2)*2*sz, tH + 2*sz + k*0.5*sz, 0)
            canopyPart.Position = pos + offset
            canopyPart.Color = colors[math.random(1, #colors)]
            canopyPart.Material = Enum.Material.Grass
            canopyPart.Anchored = true
            canopyPart.Transparency = 0.15
            canopyPart.Parent = folder
        end
        
    elseif tType == "Dead" then
        trunk.Color = Color3.fromRGB(60, 50, 40)
        trunk.Material = Enum.Material.Slate
        
        -- Galhos retorcidos e quebrados
        for i = 1, 7 do
            local deadBranch = Instance.new("Part")
            deadBranch.Size = Vector3.new(0.4*sz, (3 + math.random()*2)*sz, 0.4*sz)
            local angle = math.rad(i * 51.4)
            local height = tH * (0.4 + i * 0.08)
            local twist = math.rad(math.random(-60, 60))
            deadBranch.CFrame = CFrame.new(pos + Vector3.new(0, height, 0)) * CFrame.Angles(twist, angle, math.rad(30 + math.random()*40))
            deadBranch.Color = Color3.fromRGB(70, 55, 45)
            deadBranch.Material = Enum.Material.Slate
            deadBranch.Anchored = true
            deadBranch.Parent = folder
            
            -- Alguns galhos quebrados
            if math.random() > 0.5 then
                local brokenPart = Instance.new("Part")
                brokenPart.Size = Vector3.new(0.3*sz, 1*sz, 0.3*sz)
                brokenPart.CFrame = deadBranch.CFrame * CFrame.new(0, deadBranch.Size.Y*0.5, 0) * CFrame.Angles(math.rad(45), 0, 0)
                brokenPart.Color = Color3.fromRGB(80, 60, 50)
                brokenPart.Material = Enum.Material.Slate
                brokenPart.Anchored = true
                brokenPart.Parent = folder
            end
        end
    end
    
    folder.Parent = workspace
    return folder
end

-- Função unificada de criação
local function MakeTree(pos, tType, sz)
    if TreeCfg.Quality == "Classic" then
        return MakeTreeClassic(pos, tType, sz)
    else
        return MakeTreeDetailed(pos, tType, sz)
    end
end

