    toggleKnob.Size = UDim2.new(0, 16, 0, 16)
    toggleKnob.Position = default and UDim2.new(1, -18, 0.5, -8) or UDim2.new(0, 2, 0.5, -8)
    toggleKnob.Parent = toggleBg
    CreateCorner(toggleKnob, UDim.new(1, 0))
    
    local isEnabled = default
    
    local toggleButton = Instance.new("TextButton")
    toggleButton.Text = ""
    toggleButton.BackgroundTransparency = 1
    toggleButton.Size = UDim2.new(1, 0, 1, 0)
    toggleButton.Parent = toggleFrame
    
    toggleButton.MouseButton1Click:Connect(function()
        isEnabled = not isEnabled
        Tween(toggleBg, {BackgroundColor3 = isEnabled and Config.AccentColor or Config.SecondaryColor})
        Tween(toggleKnob, {Position = isEnabled and UDim2.new(1, -18, 0.5, -8) or UDim2.new(0, 2, 0.5, -8)})
        if callback then callback(isEnabled) end
    end)
    
    return toggleFrame, function() return isEnabled end
end

