-- Painting handler
local lastPaintTime = 0
local paintCooldown = 0.1

Mouse.Button1Down:Connect(function()
    if not isPainting then return end
    if not TreeWindow.Visible then return end
    
    local target = Mouse.Target
    if not target then return end
    
    -- Paint trees
    local paintConnection
    paintConnection = RunService.RenderStepped:Connect(function()
        if not UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1) then
            paintConnection:Disconnect()
            return
        end
        
        if not isPainting then
            paintConnection:Disconnect()
            return
        end
        
        if tick() - lastPaintTime < paintCooldown then return end
        lastPaintTime = tick()
        
        local target = Mouse.Target
        if not target then return end
        
        local hitPos = Mouse.Hit.Position
        
        for i = 1, TreeSettings.TreeDensity do
            local offsetX = (math.random() - 0.5) * TreeSettings.BrushSize * 2
            local offsetZ = (math.random() - 0.5) * TreeSettings.BrushSize * 2
            local treePos = hitPos + Vector3.new(offsetX, 0, offsetZ)
            
            -- Raycast to find ground
            local ray = Ray.new(treePos + Vector3.new(0, 50, 0), Vector3.new(0, -100, 0))
            local hit, pos = workspace:FindPartOnRay(ray, treeFolder)
            
            if hit then
                local scale = TreeSettings.MinScale + math.random() * (TreeSettings.MaxScale - TreeSettings.MinScale)
                local tree
                
                if TreeSettings.Mode == "Classic" then
                    tree = CreateClassicTree(pos, scale)
                else
                    tree = CreateDetailedTree(pos, scale)
                end
                
                tree.Parent = treeFolder
            end
        end
    end)
end)

