local _, getText3DSize = CreateSlider(EssScroll, "Text Size", UDim2.new(0, 0, 0, 0), 1, 10, 2, function(val)
    text3DSettings.Size = val
end)

CreateButton(EssScroll, "📝 Generate 3D Text", UDim2.new(0, 0, 0, 0), UDim2.new(1, 0, 0, 35), function()
    local text = textInput.Text
    if text == "" then
        Notification("Essential Tools", "Please enter some text!", "error")
        return
    end
    
    local char = Player.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    
    local textModel = Instance.new("Model")
    textModel.Name = "3DText_" .. text
    
    local spacing = text3DSettings.Size * 1.2
    local startPos = hrp.Position + Vector3.new(0, 5, -10)
    
    for i = 1, #text do
        local char = text:sub(i, i)
        local charPart = Instance.new("Part")
        charPart.Name = "Char_" .. char
        charPart.Size = Vector3.new(text3DSettings.Size, text3DSettings.Size * 1.5, 0.5)
        charPart.Color = text3DSettings.Color
        charPart.Material = Enum.Material.SmoothPlastic
        charPart.Anchored = true
        charPart.Position = startPos + Vector3.new((i - 1) * spacing - (#text * spacing / 2), 0, 0)
        charPart.Parent = textModel
        
        local surfaceGui = Instance.new("SurfaceGui")
        surfaceGui.Face = Enum.NormalId.Front
        surfaceGui.Parent = charPart
        
        local textLabel = Instance.new("TextLabel")
        textLabel.Text = char
        textLabel.Size = UDim2.new(1, 0, 1, 0)
        textLabel.BackgroundTransparency = 1
        textLabel.TextColor3 = Color3.fromRGB(0, 0, 0)
        textLabel.TextScaled = true
        textLabel.Font = Enum.Font.GothamBold
        textLabel.Parent = surfaceGui
        
        -- Back face
        local backGui = Instance.new("SurfaceGui")
        backGui.Face = Enum.NormalId.Back
        backGui.Parent = charPart
        
        local backLabel = Instance.new("TextLabel")
        backLabel.Text = char
        backLabel.Size = UDim2.new(1, 0, 1, 0)
        backLabel.BackgroundTransparency = 1
        backLabel.TextColor3 = Color3.fromRGB(0, 0, 0)
        backLabel.TextScaled = true
        backLabel.Font = Enum.Font.GothamBold
        backLabel.Parent = backGui
    end
    
    textModel.Parent = workspace
    Notification("Essential Tools", "3D Text generated!", "success")
end)

