    pcall(function() curVal = (Lighting[prop] - minVal) / (maxVal - minVal) end)
    
    local fill = Instance.new("Frame")
    fill.BackgroundColor3 = Color3.fromRGB(255, 200, 50)
    fill.Size = UDim2.new(math.clamp(curVal, 0, 1), 0, 1, 0)
    fill.ZIndex = 104
