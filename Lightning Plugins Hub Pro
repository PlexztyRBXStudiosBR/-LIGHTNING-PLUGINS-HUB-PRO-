-- Função para criar árvore clássica
local function CreateClassicTree(position, scale)
    local tree = Instance.new("Model")
    tree.Name = "ClassicTree"

-- Tronco
    local trunk = Instance.new("Part")
    trunk.Name = "Trunk"
    trunk.Size = Vector3.new(2 * scale, 8 * scale, 2 * scale)
    trunk.BrickColor = BrickColor.new("Brown")
    trunk.Material = Enum.Material.Wood
    trunk.Anchored = true
    trunk.CFrame = CFrame.new(position + Vector3.new(0, 4 * scale, 0))
    trunk.Parent = tree
    
    -- Copa (várias camadas)
    local leavesSizes = {
        {size = Vector3.new(8, 4, 8), offset = 8},
        {size = Vector3.new(6, 3, 6), offset = 11},
        {size = Vector3.new(4, 2, 4), offset = 13.5}
    }
    
    for i, data in ipairs(leavesSizes) do
        local leaves = Instance.new("Part")
        leaves.Name = "Leaves" .. i
        leaves.Size = data.size * scale
        if TreeSettings.Variety == "Different" then
            local greenVariation = math.random(-30, 30)
            leaves.Color = Color3.fromRGB(34 + greenVariation, 139 + greenVariation, 34)
        else
            leaves.Color = TreeSettings.LeavesColor
        end
        leaves.Material = Enum.Material.Grass
        leaves.Anchored = true
        leaves.CFrame = CFrame.new(position + Vector3.new(0, data.offset * scale, 0))
        leaves.Parent = tree
    end
    
    tree.PrimaryPart = trunk
    return tree
end

-- Função para criar árvore detalhada
local function CreateDetailedTree(position, scale)
    local tree = Instance.new("Model")
    tree.Name = "DetailedTree"
    
    -- Tronco principal com textura
    local trunk = Instance.new("Part")
    trunk.Name = "Trunk"
    trunk.Size = Vector3.new(1.5 * scale, 10 * scale, 1.5 * scale)
    trunk.BrickColor = BrickColor.new("Dark taupe")
    trunk.Material = Enum.Material.Wood
    trunk.Anchored = true
    trunk.CFrame = CFrame.new(position + Vector3.new(0, 5 * scale, 0))
    trunk.Parent = tree
    CreateCorner(trunk, UDim.new(0.1, 0))
    
    -- Raízes
    for i = 1, 4 do
        local root = Instance.new("Part")
        root.Name = "Root" .. i
        root.Size = Vector3.new(0.5 * scale, 1.5 * scale, 0.5 * scale)
        root.BrickColor = BrickColor.new("Dark taupe")
        root.Material = Enum.Material.Wood
        root.Anchored = true
        local angle = (i - 1) * (math.pi / 2)
        root.CFrame = CFrame.new(position + Vector3.new(math.cos(angle) * 1 * scale, 0.5 * scale, math.sin(angle) * 1 * scale)) * CFrame.Angles(0, angle, math.rad(30))
        root.Parent = tree
    end
    
    -- Galhos
    for i = 1, 3 do
        local branch = Instance.new("Part")
        branch.Name = "Branch" .. i
        branch.Size = Vector3.new(0.4 * scale, 3 * scale, 0.4 * scale)
        branch.BrickColor = BrickColor.new("Dark taupe")
        branch.Material = Enum.Material.Wood
        branch.Anchored = true
        local height = 6 + i * 1.5
        local angle = (i - 1) * (2 * math.pi / 3) + math.random() * 0.5
        branch.CFrame = CFrame.new(position + Vector3.new(math.cos(angle) * 1.5 * scale, height * scale, math.sin(angle) * 1.5 * scale)) * CFrame.Angles(0, angle, math.rad(45))
        branch.Parent = tree
        
        -- Folhagem no galho
        local branchLeaves = Instance.new("Part")
        branchLeaves.Name = "BranchLeaves" .. i
        branchLeaves.Size = Vector3.new(3 * scale, 2 * scale, 3 * scale)
        branchLeaves.Shape = Enum.PartType.Ball
        if TreeSettings.Variety == "Different" then
            local greenVariation = math.random(-30, 30)
            branchLeaves.Color = Color3.fromRGB(34 + greenVariation, 139 + greenVariation, 34)
        else
            branchLeaves.Color = TreeSettings.LeavesColor
        end
        branchLeaves.Material = Enum.Material.Grass
        branchLeaves.Anchored = true
        branchLeaves.CFrame = CFrame.new(position + Vector3.new(math.cos(angle) * 3 * scale, (height + 2) * scale, math.sin(angle) * 3 * scale))
        branchLeaves.Parent = tree
    end
    
    -- Copa principal (múltiplas esferas)
    local mainLeavesPositions = {
        {offset = Vector3.new(0, 12, 0), size = 5},
        {offset = Vector3.new(2, 11, 1), size = 3},
        {offset = Vector3.new(-2, 11, -1), size = 3},
        {offset = Vector3.new(1, 13, -2), size = 2.5},
        {offset = Vector3.new(-1, 13, 2), size = 2.5},
        {offset = Vector3.new(0, 14.5, 0), size = 2}
    }
    
    for i, data in ipairs(mainLeavesPositions) do
        local leaves = Instance.new("Part")
        leaves.Name = "MainLeaves" .. i
        leaves.Size = Vector3.new(data.size, data.size, data.size) * scale
        leaves.Shape = Enum.PartType.Ball
        if TreeSettings.Variety == "Different" then
            local greenVariation = math.random(-30, 30)
            leaves.Color = Color3.fromRGB(34 + greenVariation, 139 + greenVariation, 34)
        else
            leaves.Color = TreeSettings.LeavesColor
        end
        leaves.Material = Enum.Material.Grass
        leaves.Anchored = true
        leaves.CFrame = CFrame.new(position + data.offset * scale)
        leaves.Parent = tree
    end
    
    tree.PrimaryPart = trunk
    return tree
end

