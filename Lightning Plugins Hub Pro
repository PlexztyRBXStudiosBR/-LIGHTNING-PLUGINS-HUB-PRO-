    arrow.TextColor3 = Config.TextColor
    arrow.BackgroundTransparency = 1
    arrow.Size = UDim2.new(0, 30, 1, 0)
    arrow.Position = UDim2.new(1, -30, 0, 0)
    arrow.Parent = button
    
    local optionsFrame = Instance.new("Frame")
    optionsFrame.BackgroundColor3 = Config.MainColor
    optionsFrame.Position = UDim2.new(0, 0, 1, 5)
    optionsFrame.Size = UDim2.new(1, 0, 0, 0)
    optionsFrame.ClipsDescendants = true
    optionsFrame.Visible = false
    optionsFrame.ZIndex = 10
    optionsFrame.Parent = dropdownFrame
    CreateCorner(optionsFrame)
    CreateStroke(optionsFrame, Config.AccentColor, 1)
    
    local layout = Instance.new("UIListLayout")
    layout.SortOrder = Enum.SortOrder.LayoutOrder
    layout.Padding = UDim.new(0, 2)
    layout.Parent = optionsFrame
    
    local isOpen = false
    local selectedValue = default
    
    for i, option in ipairs(options) do
        local optBtn = Instance.new("TextButton")
        optBtn.Text = "  " .. tostring(option)
        optBtn.Font = Config.Font
        optBtn.TextSize = 12
        optBtn.TextColor3 = Config.TextColor
        optBtn.TextXAlignment = Enum.TextXAlignment.Left
        optBtn.BackgroundColor3 = Config.SecondaryColor
        optBtn.Size = UDim2.new(1, 0, 0, 25)
        optBtn.AutoButtonColor = false
        optBtn.ZIndex = 11
        optBtn.Parent = optionsFrame
        
        optBtn.MouseEnter:Connect(function()
            Tween(optBtn, {BackgroundColor3 = Config.AccentColor})
        end)
        
        optBtn.MouseLeave:Connect(function()
            Tween(optBtn, {BackgroundColor3 = Config.SecondaryColor})
        end)
        
        optBtn.MouseButton1Click:Connect(function()
            selectedValue = option
            button.Text = "  " .. name .. ": " .. tostring(option)
            isOpen = false
            Tween(optionsFrame, {Size = UDim2.new(1, 0, 0, 0)}, 0.2)
            Tween(arrow, {Rotation = 0})
            wait(0.2)
            optionsFrame.Visible = false
            if callback then callback(option) end
        end)
    end
    
    button.MouseButton1Click:Connect(function()
        isOpen = not isOpen
        if isOpen then
            optionsFrame.Visible = true
            Tween(optionsFrame, {Size = UDim2.new(1, 0, 0, #options * 27)}, 0.2)
            Tween(arrow, {Rotation = 180})
        else
            Tween(optionsFrame, {Size = UDim2.new(1, 0, 0, 0)}, 0.2)
            Tween(arrow, {Rotation = 0})
            wait(0.2)
            optionsFrame.Visible = false
        end
    end)
    
    return dropdownFrame, function() return selectedValue end
end

local function CreateToggle(parent, name, position, default, callback)
