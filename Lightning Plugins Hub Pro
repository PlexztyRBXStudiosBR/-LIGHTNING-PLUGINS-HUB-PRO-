-- ARCHIMEDES COM ALINHAMENTO CORRETO
local function BuildArchShape(pos)
    local shape = ArchConfig.Shape
    local segs = math.max(3, ArchConfig.Segments)
    local rad = ArchConfig.Radius
    local ang = math.rad(ArchConfig.Angle)
    local hgt = ArchConfig.Height
    local pSize = ArchConfig.PartSize
    
    local folder = Instance.new("Model")
    folder.Name = "Arch_" .. shape
    folder.Parent = workspace
    
    local parts = {}
    
    for i = 0, segs - 1 do
        local part = Instance.new("Part")
        part.Size = pSize
        part.Material = Enum.Material.SmoothPlastic
        part.Color = Color3.fromRGB(100, 150, 255)
        part.Anchored = true
        part.CanCollide = false
        part.Parent = folder
        
        local t = i / math.max(1, segs - 1)
        local nextT = (i + 1) / math.max(1, segs - 1)
        local curAng = ang * t
        local nextAng = ang * nextT
        
        local x, y, z, nextX, nextY, nextZ
        
        if shape == "Arc" then
            x = math.cos(curAng) * rad
            y = hgt * t
            z = math.sin(curAng) * rad
            nextX = math.cos(nextAng) * rad
            nextY = hgt * nextT
            nextZ = math.sin(nextAng) * rad
        elseif shape == "Spiral" then
            local sRad = rad * (1 - t * 0.5)
            local nextSRad = rad * (1 - nextT * 0.5)
            x = math.cos(curAng * 2) * sRad
            y = hgt * t
            z = math.sin(curAng * 2) * sRad
            nextX = math.cos(nextAng * 2) * nextSRad
            nextY = hgt * nextT
            nextZ = math.sin(nextAng * 2) * nextSRad
        elseif shape == "Circle" then
            curAng = math.pi * 2 * t
            nextAng = math.pi * 2 * nextT
            x = math.cos(curAng) * rad
            y = 0
            z = math.sin(curAng) * rad
            nextX = math.cos(nextAng) * rad
            nextY = 0
            nextZ = math.sin(nextAng) * rad
        elseif shape == "Helix" then
            curAng = math.pi * 4 * t
            nextAng = math.pi * 4 * nextT
            x = math.cos(curAng) * rad
            y = hgt * t
            z = math.sin(curAng) * rad
            nextX = math.cos(nextAng) * rad
            nextY = hgt * nextT
            nextZ = math.sin(nextAng) * rad
        end
        
        local currentPos = pos + Vector3.new(x, y, z)
        local nextPos = pos + Vector3.new(nextX, nextY, nextZ)
        
        -- Alinhamento correto: olhar para o próximo ponto
        if i < segs - 1 then
            local direction = (nextPos - currentPos).Unit
            part.CFrame = CFrame.new(currentPos, currentPos + direction)
        else
            -- Última peça mantém rotação da penúltima
            if #parts > 0 then
                part.CFrame = parts[#parts].CFrame + (currentPos - parts[#parts].Position)
            else
                part.CFrame = CFrame.new(currentPos)
            end
        end
        
        table.insert(parts, part)
    end
end

