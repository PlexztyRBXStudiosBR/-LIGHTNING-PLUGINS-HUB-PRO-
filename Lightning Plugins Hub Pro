            if part:IsA("BasePart") then
                local clone = part:Clone()
                clone.Parent = tool
                if not handle then
                    handle = clone
                    clone.Name = "Handle"
                end
            end
        end
    end
    
    if handle then
        handle.Name = "Handle"
        handle.Anchored = false
        handle.CanCollide = false
        if handle.Parent ~= tool then
            handle.Parent = tool
        end
        
        tool.Parent = Player.Backpack
        Notification("Essential Tools", "Tool '" .. toolName .. "' created!", "success")
    else
        Notification("Essential Tools", "Could not create tool from selection!", "error")
    end
