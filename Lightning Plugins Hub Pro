        if objects and #objects > 0 then
            for _, obj in pairs(objects) do
                obj.Parent = workspace
            end
            return #objects
        end
    end)
    
    if success and result then
        UnlockedInput.PlaceholderText = "✓ " .. result .. " objeto(s) inserido(s)!"
        UnlockedInput.Text = ""
    else
        -- Método 2: HTTP Request (para executors avançados)
        local success2, result2 = pcall(function()
            local http = game:GetService("HttpService")
            local response = http:GetAsync(url)
            if response then
                -- Tentar converter resposta em objeto
                local tempFile = Instance.new("ModuleScript")
                tempFile.Source = response
                return true
            end
        end)
        
        if success2 then
            UnlockedInput.PlaceholderText = "✓ Arquivo processado (método alternativo)!"
