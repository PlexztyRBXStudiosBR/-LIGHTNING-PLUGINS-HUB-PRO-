-- ============================================
-- GLOBAL INPUT HANDLER (SELECTION + PLACEMENT)
-- ============================================

local isPlacing = false
local lastPlaceTime = 0

UserInputService.InputBegan:Connect(function(input, processed)
    if processed then return end
    if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
        if IsTouchOnUI(input.Position) then return end
        local pos, hit = RaycastWorld(input.Position)
        
        -- Archimedes placement
        if ArchConfig.Placing and hit and pos then
            BuildArchShape(pos)
            ArchConfig.Placing = false
            ArchBtn.Text = "POSICIONAR NO MUNDO"
            ArchBtn.BackgroundColor3 = Color3.fromRGB(255, 100, 100)
        end
        
        -- Tree placement
        if TreeCfg.Placing and hit and pos then
            isPlacing = true
            local tType = TreeCfg.Mode == "Different" and TreeTypes[math.random(1, #TreeTypes)].N or TreeCfg.TreeType
            local szVar = TreeCfg.Mode == "Different" and (TreeCfg.Size * (0.7 + math.random() * 0.6)) or TreeCfg.Size
            MakeTree(pos, tType, szVar)
            lastPlaceTime = tick()
        end
        
        -- Object selection for Essential Tools
        if EssentialFrame.Visible then
            local mouse = Player:GetMouse()
            local target = mouse.Target
            if target and (target.Parent:IsA("Model") or target.Parent:IsA("Folder")) then
                selectedObject = target.Parent
                SelectInfo.Text = "Selecionado: " .. selectedObject.Name .. " (" .. selectedObject.ClassName .. ")"
                SelectInfo.TextColor3 = Theme.Success
            elseif target and target:IsA("BasePart") then
                selectedObject = target
                SelectInfo.Text = "Selecionado: " .. target.Name .. " (Part)"
                SelectInfo.TextColor3 = Theme.Success
            end
        end
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if not isPlacing or not TreeCfg.Placing then return end
    if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseMovement then
        if IsTouchOnUI(input.Position) then return end
        local pos, hit = RaycastWorld(input.Position)
        if hit and pos then
            local timeOK = tick() - lastPlaceTime >= treeInterval / TreeCfg.Density
            if timeOK then
                local tType = TreeCfg.Mode == "Different" and TreeTypes[math.random(1, #TreeTypes)].N or TreeCfg.TreeType
                local szVar = TreeCfg.Mode == "Different" and (TreeCfg.Size * (0.7 + math.random() * 0.6)) or TreeCfg.Size
                MakeTree(pos, tType, szVar)
                lastPlaceTime = tick()
            end
        end
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
        isPlacing = false
    end
end)

