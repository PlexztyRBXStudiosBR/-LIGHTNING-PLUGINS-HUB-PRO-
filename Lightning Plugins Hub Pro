local function BuildArchShape(pos)
    local shape = ArchConfig.Shape
    local segs = ArchConfig.Segments
    local rad = ArchConfig.Radius
    local ang = math.rad(ArchConfig.Angle)
    local hgt = ArchConfig.Height
    local pSize = ArchConfig.PartSize
    
    local folder = Instance.new("Folder")
    folder.Name = "Arch_" .. shape
    folder.Parent = workspace
    
    for i = 0, segs - 1 do
        local part = Instance.new("Part")
        part.Size = pSize
        part.Material = Enum.Material.SmoothPlastic
        part.Color = Color3.fromRGB(100, 150, 255)
        part.Anchored = true
        part.Parent = folder
        
        local t = i / math.max(1, segs - 1)
        local curAng = ang * t
        local x, y, z
        
        if shape == "Arc" then
            x = math.cos(curAng) * rad
            y = hgt * t
            z = math.sin(curAng) * rad
        elseif shape == "Spiral" then
            local sRad = rad * (1 - t * 0.5)
            x = math.cos(curAng * 2) * sRad
            y = hgt * t
            z = math.sin(curAng * 2) * sRad
        elseif shape == "Circle" then
            curAng = math.pi * 2 * t
            x = math.cos(curAng) * rad
            y = 0
            z = math.sin(curAng) * rad
        elseif shape == "Helix" then
            curAng = math.pi * 4 * t
            x = math.cos(curAng) * rad
            y = hgt * t
            z = math.sin(curAng) * rad
        end
        
        part.Position = pos + Vector3.new(x, y, z)
        part.CFrame = CFrame.new(part.Position) * CFrame.Angles(0, curAng, 0)
    end
end

