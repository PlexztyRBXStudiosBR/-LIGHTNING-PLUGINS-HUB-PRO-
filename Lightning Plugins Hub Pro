-- Função para criar formas do Archimedes (CORRIGIDA E MELHORADA)
local function CreateArchimedesShape()
    local char = Player.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    
    local centerPos = hrp.Position + Vector3.new(0, 5, 10)
    local model = Instance.new("Model")
    model.Name = "ArchimedesShape_" .. ArchSettings.Shape
    
    local partCount = ArchSettings.PartCount
    local radius = ArchSettings.Radius
    local angle = math.rad(ArchSettings.Angle)
    local height = ArchSettings.Height
    local partSize = ArchSettings.PartSize
    local color = GetArchColor()
    local axis = ArchSettings.Axis
    
    local parts = {}
    
    if ArchSettings.Shape == "Arc" then
        local angleStep = angle / (partCount - 1)
        for i = 0, partCount - 1 do
            local currentAngle = -angle/2 + (angleStep * i)
            local part = Instance.new("Part")
            part.Size = partSize
            part.Color = color
            part.Material = Enum.Material.SmoothPlastic
            part.Anchored = true
            part.CanCollide = true
            
            local x = math.cos(currentAngle) * radius
            local z = math.sin(currentAngle) * radius
            local y = (height / (partCount - 1)) * i
            
            if axis == "X" then
                part.Position = centerPos + Vector3.new(y, z, x)
                part.CFrame = CFrame.new(part.Position) * CFrame.Angles(0, currentAngle + math.pi/2, 0)
            elseif axis == "Y" then
                part.Position = centerPos + Vector3.new(x, y, z)
                part.CFrame = CFrame.new(part.Position) * CFrame.Angles(0, -currentAngle, 0)
            else
                part.Position = centerPos + Vector3.new(x, z, y)
                part.CFrame = CFrame.new(part.Position) * CFrame.Angles(0, -currentAngle, 0)
            end
            
            part.Parent = model
            table.insert(parts, part)
        end
        
    elseif ArchSettings.Shape == "Circle" then
        local angleStep = (math.pi * 2) / partCount
        for i = 0, partCount - 1 do
            local currentAngle = angleStep * i
            local part = Instance.new("Part")
            part.Size = partSize
            part.Color = color
            part.Material = Enum.Material.SmoothPlastic
            part.Anchored = true
            part.CanCollide = true
            
            local x = math.cos(currentAngle) * radius
            local z = math.sin(currentAngle) * radius
            
            if axis == "X" then
                part.Position = centerPos + Vector3.new(0, z, x)
                part.CFrame = CFrame.new(part.Position) * CFrame.Angles(0, currentAngle + math.pi/2, 0)
            elseif axis == "Y" then
                part.Position = centerPos + Vector3.new(x, 0, z)
                part.CFrame = CFrame.new(part.Position) * CFrame.Angles(0, -currentAngle, 0)
            else
                part.Position = centerPos + Vector3.new(x, z, 0)
                part.CFrame = CFrame.new(part.Position) * CFrame.Angles(0, -currentAngle, 0)
            end
            
            part.Parent = model
            table.insert(parts, part)
        end
        
    elseif ArchSettings.Shape == "Helix" then
        local angleStep = (math.pi * 2 * 2) / partCount -- 2 rotações completas
        local heightStep = height / partCount
        for i = 0, partCount - 1 do
            local currentAngle = angleStep * i
            local part = Instance.new("Part")
            part.Size = partSize
            part.Color = color
            part.Material = Enum.Material.SmoothPlastic
            part.Anchored = true
            part.CanCollide = true
            
            local x = math.cos(currentAngle) * radius
            local z = math.sin(currentAngle) * radius
            local y = heightStep * i
            
            part.Position = centerPos + Vector3.new(x, y, z)
            part.CFrame = CFrame.new(part.Position) * CFrame.Angles(0, -currentAngle, 0)
            
            part.Parent = model
            table.insert(parts, part)
        end
        
    elseif ArchSettings.Shape == "Sphere" then
        local latStep = math.pi / math.sqrt(partCount)
        local lonStep = (math.pi * 2) / math.sqrt(partCount)
        local count = 0
        
        for lat = -math.pi/2, math.pi/2, latStep do
            for lon = 0, math.pi * 2, lonStep do
                if count >= partCount then break end
                local part = Instance.new("Part")
                part.Size = partSize
                part.Color = color
                part.Material = Enum.Material.SmoothPlastic
                part.Anchored = true
                part.CanCollide = true
                
                local x = math.cos(lat) * math.cos(lon) * radius
                local y = math.sin(lat) * radius
                local z = math.cos(lat) * math.sin(lon) * radius
                
                part.Position = centerPos + Vector3.new(x, y, z)
                part.CFrame = CFrame.new(part.Position, centerPos)
                
                part.Parent = model
                table.insert(parts, part)
                count = count + 1
            end
            if count >= partCount then break end
        end
        
    elseif ArchSettings.Shape == "Dome" then
        local latStep = (math.pi/2) / math.sqrt(partCount)
        local lonStep = (math.pi * 2) / math.sqrt(partCount)
        local count = 0
        
        for lat = 0, math.pi/2, latStep do
            for lon = 0, math.pi * 2, lonStep do
                if count >= partCount then break end
                local part = Instance.new("Part")
                part.Size = partSize
                part.Color = color
                part.Material = Enum.Material.SmoothPlastic
                part.Anchored = true
                part.CanCollide = true
                
                local x = math.cos(lat) * math.cos(lon) * radius
                local y = math.sin(lat) * radius
                local z = math.cos(lat) * math.sin(lon) * radius
                
                part.Position = centerPos + Vector3.new(x, y, z)
                part.CFrame = CFrame.new(part.Position, centerPos)
                
                part.Parent = model
                table.insert(parts, part)
                count = count + 1
            end
            if count >= partCount then break end
        end
        
    elseif ArchSettings.Shape == "Cylinder" then
        local angleStep = (math.pi * 2) / (partCount / 2)
        local heightStep = height / (partCount / 2)
        local count = 0
        
        for h = 0, height, heightStep do
            for i = 0, (partCount / 2) - 1 do
                if count >= partCount then break end
                local currentAngle = angleStep * i
                local part = Instance.new("Part")
                part.Size = partSize
                part.Color = color
                part.Material = Enum.Material.SmoothPlastic
                part.Anchored = true
                part.CanCollide = true
                
                local x = math.cos(currentAngle) * radius
                local z = math.sin(currentAngle) * radius
                
                part.Position = centerPos + Vector3.new(x, h, z)
                part.CFrame = CFrame.new(part.Position) * CFrame.Angles(0, -currentAngle, 0)
                
                part.Parent = model
                table.insert(parts, part)
                count = count + 1
            end
            if count >= partCount then break end
        end
        
    elseif ArchSettings.Shape == "Spiral" then
        local angleStep = (math.pi * 2 * 3) / partCount
        local radiusStep = radius / partCount
        for i = 0, partCount - 1 do
            local currentAngle = angleStep * i
            local currentRadius = radiusStep * (i + 1)
            local part = Instance.new("Part")
            part.Size = partSize
            part.Color = color
            part.Material = Enum.Material.SmoothPlastic
            part.Anchored = true
            part.CanCollide = true
            
            local x = math.cos(currentAngle) * currentRadius
            local z = math.sin(currentAngle) * currentRadius
            
            part.Position = centerPos + Vector3.new(x, 0, z)
            part.CFrame = CFrame.new(part.Position) * CFrame.Angles(0, -currentAngle, 0)
            
            part.Parent = model
            table.insert(parts, part)
        end
    end
    
    -- Definir Primary Part
    if #parts > 0 then
        model.PrimaryPart = parts[1]
    end
    
    model.Parent = workspace
    Notification("Archimedes", ArchSettings.Shape .. " created with " .. #parts .. " parts!", "success")
end

